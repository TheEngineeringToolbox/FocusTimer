<Window x:Class="FocusTimer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instellingen" Width="390" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#202124" Foreground="White">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F3F4F6"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F3F4F6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#9CA3AF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="CaretBrush" Value="#111827"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.ColumnSpan="2" Text="Pomodoro-instellingen" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
    <TextBlock Grid.Row="1" Text="Focusduur (minuten)" VerticalAlignment="Center"/><TextBox x:Name="FocusBox" Grid.Row="1" Grid.Column="1" Margin="8,4"/>
    <TextBlock Grid.Row="2" Text="Korte pauze (minuten)" VerticalAlignment="Center"/><TextBox x:Name="ShortBox" Grid.Row="2" Grid.Column="1" Margin="8,4"/>
    <TextBlock Grid.Row="3" Text="Lange pauze (minuten)" VerticalAlignment="Center"/><TextBox x:Name="LongBox" Grid.Row="3" Grid.Column="1" Margin="8,4"/>
    <TextBlock Grid.Row="4" Text="Pomodoro's tot lange pauze" VerticalAlignment="Center"/><TextBox x:Name="CyclesBox" Grid.Row="4" Grid.Column="1" Margin="8,4"/>
    <CheckBox x:Name="AutoStartBox" Grid.Row="5" Grid.ColumnSpan="2" Content="Volgende fase automatisch starten" Margin="0,10,0,4"/>
    <CheckBox x:Name="SoundBox" Grid.Row="6" Grid.ColumnSpan="2" Content="Notificatiegeluid" Margin="0,4"/>
    <CheckBox x:Name="StartupBox" Grid.Row="7" Grid.ColumnSpan="2" Content="Starten met Windows" Margin="0,4"/>
    <CheckBox x:Name="MinimizeBox" Grid.Row="8" Grid.ColumnSpan="2" Content="Sluiten minimaliseert naar system tray" Margin="0,4" VerticalAlignment="Top"/>
    <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Annuleren" Width="88" Margin="4" IsCancel="True"/>
      <Button Content="Opslaan" Width="88" Margin="4" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
