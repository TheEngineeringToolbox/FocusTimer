<Window x:Class="FocusTimer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Timer" Width="320" Height="280" WindowStartupLocation="CenterScreen" Background="#202124" Foreground="White"
        Icon="Assets/FocusTimer.ico" ResizeMode="CanMinimize" KeyDown="OnKeyDown">
  <Window.TaskbarItemInfo><TaskbarItemInfo x:Name="TaskbarProgress"/></Window.TaskbarItemInfo>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="PhaseText" Text="FOCUS" Foreground="#7DD3FC" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
      <TextBlock x:Name="TimeText" Text="25:00" FontSize="54" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
      <TextBlock x:Name="ProgressText" Text="0 / 4" Foreground="#BFC3C9" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
      <Button x:Name="StartButton" Content="Start" Width="78" Margin="3" Click="Start_Click"/>
      <Button Content="Reset" Width="65" Margin="3" Click="Reset_Click"/>
      <Button Content="Skip" Width="65" Margin="3" Click="Skip_Click"/>
      <Button Content="⚙" Width="38" Margin="3" Click="Settings_Click" ToolTip="Instellingen"/>
    </StackPanel>
    <TextBlock x:Name="TodayText" Grid.Row="2" Text="Vandaag: 0 Pomodoro's / 0 minuten focus"
               Foreground="#B8BDC5" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
               TextAlignment="Center" TextWrapping="NoWrap"/>
  </Grid>
</Window>
